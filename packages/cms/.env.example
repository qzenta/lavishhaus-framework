# Required — any random string in development. Use a long, unique secret in
# production and never commit the real value.
PAYLOAD_SECRET=

# SQLite by design for Track 2 scaffolding (no external database needed to
# develop/verify this package). Swap for a Postgres connection string (e.g.
# via @payloadcms/db-postgres) before any real content entry or production use.
DATABASE_URI=file:./cms.db
